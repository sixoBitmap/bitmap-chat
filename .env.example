# The server's Anthropic API key (console.anthropic.com -> API keys).
# OPTIONAL. When set, every signed-in wallet gets ONE free question per UTC
# day on this key (any bitmap, context capped at FREE_CONTEXT_CAP); after
# that visitors must add their own key in Settings (⚙) until the day changes.
# Leave empty to require every visitor to bring their own key for everything.
# Visitor keys always take precedence and spend the visitor's own budget.
ANTHROPIC_API_KEY=

PORT=3100

# Every on-chain call uses the ord recursive API (/r/*, /content/*).
# Default gateway is ordinals.com ONLY. Override with a comma-separated list,
# e.g. a self-hosted ord node (same recursive API) for hosted deploys where
# ordinals.com blocks datacenter IPs:
#ORD_API=https://ordinals.com

# --- buying questions with BTC ---
# Address that receives payments. MUST be one you control.
#PAY_ADDRESS=34DXHZZebFcBkq5VsNDmMkVMNu7hWdRL14
#EUR_PER_QUESTION=1          # ~1 EUR per question, converted live to sats
#MIN_CONFIRMATIONS=1         # confirmations before questions are credited
#QUOTE_TTL_MS=1800000        # how long a quoted price is held (unpaid quotes
                             # are never saved — only broadcast payments are)
#ORDERS_FILE=.questions.json # balances + order history (gitignored)
# Promo codes are SECRET, created in the admin panel, and never sent to the
# client. Each one carries its own limits: uses per wallet and uses in total.

# Crawl caps (defaults shown)
#CRAWL_MAX_NODES=1500
#CRAWL_MAX_DEPTH=6
#CRAWL_CHILD_PAGE_CAP=10
#CRAWL_PARENT_PAGE_CAP=3
#CRAWL_SAT_SCAN_LIMIT=300
#CRAWL_SAT_PAGE_CAP=3
#CRAWL_TEXT_ITEM_CAP=10000
#CRAWL_TEXT_TOTAL_CAP=2000000
#CRAWL_IMAGE_CAP=8
#CRAWL_IMAGE_MAX_BYTES=1500000
#CRAWL_CONCURRENCY=6
#CRAWL_TIMEOUT_MS=360000
#CRAWL_TTL_MS=600000

# Chat cost knobs. Context budget: default when the client doesn't ask;
# visitors can pick up to 1M (their own key) or FREE_CONTEXT_CAP (free
# question on the server key) from the UI Settings.
#CONTEXT_TOKEN_BUDGET=200000
#FREE_CONTEXT_CAP=200000
#CHAT_MAX_TOKENS=12000
#DAILY_TOKEN_LIMIT=
# Free-question ledger file (address -> day), survives restarts
#QUOTA_FILE=.free-quota.json

# Wallet gate: users scan only bitmaps their wallet holds, unless the wallet
# holds a parcel/pathscribe of GATE_BITMAP (then any bitmap). WALLET_GATE=0
# disables the gate entirely. Parcels are found LIVE via ordinals.com
# /r/children; wallet contents come from the Xverse address API (ordinals.com
# has no address API).
#WALLET_GATE=1
#GATE_BITMAP=114588
# Free questions per UTC day = FREE_BASE + 1 per PathScriber + 1 per parcel.
# FREE_MAX_PER_DAY caps the total (0 = uncapped) — worth setting on a public
# deploy, since every free question is billed to YOUR key.
#FREE_BASE=1
#FREE_MAX_PER_DAY=0

# --- admin panel (/admin.html) ---
# Your secret code. Needed IN ADDITION to holding the gate bitmap (or being
# granted access from inside the panel). Empty/short = panel disabled.
#ADMIN_CODE=
#ADMIN_FILE=.admin.json      # promo codes, granted admins, PathScriber registry
#CLAIMS_FILE=.claims.json    # PathScribers claimed by id from the wallet popup
# The house prompt saved from the admin panel's "AI prompt" tab. Readers can
# wrap it with their own: a PathScriber unlocks the top slot, a gate-bitmap
# parcel the bottom one, both together their own copy of the middle.
#PROMPT_FILE=.system-prompt.txt
#USER_PROMPT_MAX=4000        # characters a reader may add above / below
#USER_MAIN_MAX=12000         # characters for a dual holder's own middle prompt
#XVERSE_API=https://api-3.xverse.app
#MARKET_URL=https://brc420.io/tokens/cd63a4c03b0091a7d4e6a30b98d15e0a15465bfaff08fac1e08dae0ae88b8462i0
# PathScriber "Original Inscription" — a wallet inscription whose content is
# exactly "/content/<this id>" counts as a PathScriber (BRC-420 mint).
#PATHSCRIBE_SOURCE=914e2538118b4cffcf1eced6187462eb1ebcfcc95146c027edba78efee00310bi0

# BIP-322 sign-in sessions. Set a long random JWT_SECRET in production —
# without it a random one is generated and all wallet sessions reset on
# every server restart. SESSION_TTL e.g. 24h, 7d.
#JWT_SECRET=
#SESSION_TTL=24h
